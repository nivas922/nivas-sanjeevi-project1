PORT=5000
NODE_ENV=development
JWT_SECRET=learnai_jwt_secret_key_super_secure_multilingual_2026
JWT_EXPIRES_IN=7d

# Database Configuration (sqlite | mysql | postgres)
DB_TYPE=sqlite
DB_FILE=./data/learnai.db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=learnai_db

# Storage Configuration (local | s3 | cloudinary)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# AI and Cloud Services
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Mobile OTP Providers (Twilio | MSG91 | dev)
OTP_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
