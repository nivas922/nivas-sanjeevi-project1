# ========================================================
# LearnAI Backend - Environment Configuration Example
# ========================================================
NODE_ENV=development
PORT=5000
JWT_SECRET=your_strong_random_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=7d
DB_TYPE=sqlite
DB_FILE=./data/learnai.db
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id
OTP_PROVIDER=dev
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
