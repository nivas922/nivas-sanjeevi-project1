# ========================================================
# LearnAI Platform - Environment Configuration Example
# ========================================================
# Copy this file to .env and configure appropriate values.
# NEVER commit real production secrets, passwords, or API keys to Git.

# Server Environment
NODE_ENV=development
PORT=5000

# Security & Authentication
# In production, JWT_SECRET is strictly mandatory and must be a 64+ char random string.
JWT_SECRET=your_strong_random_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Database Configuration (SQLite)
DB_TYPE=sqlite
DB_FILE=./data/learnai.db

# Storage & Uploads
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
OPENAI_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# OTP Providers (dev / twilio / msg91)
OTP_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=

# CORS & Network Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
